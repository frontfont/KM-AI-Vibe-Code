{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/frontfont/km-ai-vibe-code/schema/kabac.schema.json",
  "title": "KABAC - Knowledge AI Business Acceleration Canvas",
  "type": "object",
  "required": ["kabac_version", "meta", "business", "adr", "reuse"],
  "additionalProperties": false,
  "$defs": {
    "bullets": {
      "description": "Golden rule #1: keep each block to at most 3 short bullets.",
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 3, "maxLength": 300 }
    },
    "businessBlock": {
      "enum": [
        "problem_opportunity",
        "value_roi",
        "users_channels",
        "data_resources",
        "cost_constraints",
        "activities_adoption"
      ]
    }
  },
  "properties": {
    "kabac_version": { "const": "1.0" },
    "meta": {
      "type": "object",
      "required": ["project", "owner", "status", "date"],
      "additionalProperties": false,
      "properties": {
        "project": { "type": "string", "minLength": 2 },
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "summary": { "type": "string", "maxLength": 200 },
        "owner": { "type": "string", "minLength": 2 },
        "status": { "enum": ["Draft", "Proposed", "Accepted", "Superseded"] },
        "superseded_by": { "type": "string" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "business": {
      "type": "object",
      "required": [
        "problem_opportunity",
        "value_roi",
        "users_channels",
        "data_resources",
        "cost_constraints",
        "activities_adoption"
      ],
      "additionalProperties": false,
      "properties": {
        "problem_opportunity": { "$ref": "#/$defs/bullets" },
        "value_roi": { "$ref": "#/$defs/bullets" },
        "users_channels": { "$ref": "#/$defs/bullets" },
        "data_resources": { "$ref": "#/$defs/bullets" },
        "cost_constraints": { "$ref": "#/$defs/bullets" },
        "activities_adoption": { "$ref": "#/$defs/bullets" }
      }
    },
    "adr": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "description": "Must contain at least one accuracy_guardrails decision.",
      "contains": {
        "type": "object",
        "properties": { "category": { "const": "accuracy_guardrails" } },
        "required": ["category"]
      },
      "items": {
        "type": "object",
        "required": [
          "id",
          "area",
          "category",
          "selected_architecture",
          "rationale",
          "links_to",
          "tradeoffs_mitigations"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^ADR-\\d{2}$" },
          "area": { "type": "string", "minLength": 3 },
          "category": {
            "enum": ["model_knowledge", "infrastructure_security", "accuracy_guardrails", "other"]
          },
          "selected_architecture": { "type": "string", "minLength": 3 },
          "rationale": { "type": "string", "minLength": 10 },
          "links_to": {
            "description": "Golden rule #2: every ADR must link back to a business block.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/businessBlock" }
          },
          "tradeoffs_mitigations": {
            "description": "Golden rule #3: no hidden risks.",
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "reuse": {
      "type": "object",
      "required": [
        "bu",
        "company",
        "asset_types",
        "data_classification",
        "connects_internal_systems",
        "decision_impact",
        "ai_vendor_model",
        "reuse_level",
        "maintainer",
        "support",
        "license"
      ],
      "additionalProperties": false,
      "properties": {
        "bu": { "type": "string", "minLength": 1 },
        "company": { "type": "string", "minLength": 1 },
        "asset_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["app", "skill", "prompt", "agent", "script", "workflow"] }
        },
        "data_classification": {
          "enum": ["public", "internal", "confidential", "restricted_pii"]
        },
        "connects_internal_systems": { "type": "boolean" },
        "decision_impact": { "enum": ["none", "assistive", "financial_or_hr"] },
        "ai_vendor_model": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 }
        },
        "reuse_level": { "enum": ["showcase_only", "reusable", "production_ready"] },
        "maintainer": { "type": "string", "minLength": 2 },
        "support": { "enum": ["none", "best_effort", "supported"] },
        "license": { "type": "string", "minLength": 2 },
        "repo_url": { "type": "string", "pattern": "^https://" },
        "demo_url": { "type": "string", "pattern": "^https://" },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  }
}
